APP_NAME=Fiber Next Starter

# Port API di DALAM container backend
APP_PORT=8000

# ----------------------------------------------------------
# Port di KOMPUTER host (bedakan per project)
# ----------------------------------------------------------
HOST_WEB_PORT=3100
HOST_API_PORT=8100
HOST_DB_PORT=3109
HOST_PMA_PORT=9192

# ----------------------------------------------------------
# Database
# DB_HOST = nama service MySQL di docker-compose, BUKAN 127.0.0.1
# ----------------------------------------------------------
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=db_app
DB_USERNAME=appuser
DB_PASSWORD=secret_app
DB_ROOT_PASSWORD=secret_root

# true = isi data dummy (units) saat start. Setelah terisi, ubah ke false.
SEED=false

# Hanya perlu jika browser memanggil API langsung (tanpa rewrite Next.js).
# Kosong = CORS mati.
# CORS_ORIGIN=http://localhost:3100
